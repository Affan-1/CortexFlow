# =============================================================
# Server
# =============================================================
PORT=5000

# =============================================================
# MongoDB
# =============================================================
MONGODB_URI=mongodb://localhost:27017/cortexflow

# =============================================================
# JWT
# =============================================================
JWT_SECRET=replace_with_a_long_random_string

# =============================================================
# Redis / BullMQ (required — the worker and queue won't start without this)
# =============================================================
REDIS_URL=redis://127.0.0.1:6379

# Optional: how many jobs a single worker process runs concurrently
WORKER_CONCURRENCY=5

# =============================================================
# AI providers — set at least ONE. If more than one is set, the
# engine defaults to OpenAI, then Anthropic, then Gemini, unless a
# node's config explicitly picks a provider.
# =============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# =============================================================
# Integrations
# =============================================================
# Nothing goes here — Gmail/Slack/Discord/Google Sheets/Notion/
# HubSpot/Webhook credentials are connected per-user at runtime via
# POST /api/integrations, not stored in .env. See README section
# "Connecting integrations" for the shape each provider expects.
